{
 "url": "{{UI}}/",
 "width": 1680,
 "height": 1000,
 "exact": true,
 "show": true,
 "timeout": 600000,
 "vars": {
  "UI": "http://localhost:5174",
  "OUT": "../../engine/run/relay-shots"
 },
 "steps": [
  {"waitFor": "#root form, #root nav", "timeout": 60000},
  {"js": "fetch('/api/auth/logout',{method:'POST'}).then(()=>{setTimeout(()=>location.reload(),100);return 'abgemeldet'})"},
  {"wait": 2500},
  {"waitFor": "#root form", "timeout": 60000},
  {"waitFor": "[data-testid=login-download]", "timeout": 15000},
  {"wait": 1500},
  {"shot": "{{OUT}}/relay-01-login-download.png", "name": "login mit Download-Karte"},
  {"click": "[data-testid=login-tab-code]"},
  {"wait": 300},
  {"type": {"target": "#root form input", "text": "{{OWNER_CODE}}"}},
  {"click": "[data-testid=login-submit]"},
  {"waitFor": "[data-testid=home-server], [data-testid=table-seat]", "timeout": 30000},
  {"js": "window.__ml.nav.getState().go('play');'play'"},
  {"waitFor": "[data-testid=lobby-row][data-hosting=REMOTE]", "timeout": 20000},
  {"wait": 1500},
  {"shot": "{{OUT}}/relay-02-lobby-remote-row.png", "name": "Lobby mit privatem Remote-Tisch"},
  {"click": "[data-testid=lobby-open-table]"},
  {"waitFor": "[data-testid=create-table-dialog]", "timeout": 10000},
  {"wait": 800},
  {"shot": "{{OUT}}/relay-03-create-dialog.png", "name": "Tisch eroeffnen (ohne Host-Link)"},
  {"click": {"sel": "[data-testid=create-table-private] ", "js": true}},
  {"wait": 600},
  {"shot": "{{OUT}}/relay-04-create-private.png", "name": "Tisch eroeffnen privat"},
  {"key": "Escape"},
  {"wait": 600},
  {"click": "[data-testid=lobby-row][data-hosting=REMOTE] [data-testid=lobby-join]"},
  {"waitFor": "[data-testid=table-password-dialog]", "timeout": 10000},
  {"wait": 600},
  {"type": {"target": "[data-testid=table-password]", "text": "falsch"}},
  {"click": "[data-testid=table-password-submit]"},
  {"wait": 1500},
  {"shot": "{{OUT}}/relay-05-password-wrong.png", "name": "Passwort falsch"},
  {"type": {"target": "[data-testid=table-password]", "text": "geheim", "clear": true}},
  {"click": "[data-testid=table-password-submit]"},
  {"waitFor": "[data-testid=table-start], [data-testid=table-leave]", "timeout": 15000},
  {"wait": 2500},
  {"jsFile": "wait-images.js", "optional": true},
  {"shot": "{{OUT}}/relay-06-table-remote.png", "name": "Tisch auf Bobs Rechner (Gast)"},
  {"click": "[data-testid=table-leave]"},
  {"wait": 1500}
 ]
}
