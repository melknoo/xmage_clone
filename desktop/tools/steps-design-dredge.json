{
  "url": "http://localhost:5173/?port=7317",
  "width": 1680,
  "height": 1000,
  "timeout": 600000,
  "steps": [
    {
      "waitFor": "#root div",
      "timeout": 60000
    },
    {
      "js": "fetch('http://127.0.0.1:7317/api/games',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({deck:{type:'random'},bots:[{type:'random'},{type:'random'},{type:'random'}],tempo:'BLITZ',scenario:'dredge'})}).then(r=>r.json()).then(j=>{window.__ml.game.getState().connect(j.gameId);window.__ml.nav.getState().go('game');return j.gameId})"
    },
    {
      "wait": 4000
    },
    {
      "jsFile": "dredge-pilot.js"
    },
    {
      "js": "new Promise(r=>{const t=setInterval(()=>{const g=window.__ml.game.getState();const p=g.prompt;if(p&&p.choice&&p.choice.groups&&g.answeredPromptId!==p.id){clearInterval(t);r('Dialog: '+p.choice.groups.map(x=>x.label+'x'+x.sources.length).join(', '))}},200)})"
    },
    {
      "wait": 1500
    },
    {
      "js": "(()=>{const b=[...document.querySelectorAll('button')].find(e=>e.textContent==='Necroplasm');if(!b)return 'kein Chip';b.dispatchEvent(new MouseEvent('mouseover',{bubbles:true}));return 'hover Necroplasm'})()"
    },
    {
      "wait": 800
    },
    {
      "js": "new Promise(r=>{const t0=Date.now();const done=i=>i.complete&&i.naturalWidth>0&&!i.classList.contains('opacity-0');const t=setInterval(()=>{const imgs=[...document.images].filter(i=>i.getBoundingClientRect().width>0);if(imgs.every(done)||Date.now()-t0>25000){clearInterval(t);setTimeout(()=>r('Bilder '+imgs.filter(done).length+'/'+imgs.length),400)}},250)})"
    },
    {
      "shot": "../../design/claude-design/screenshots/57-ersatzeffekt-dialog.png"
    },
    {
      "wait": 300
    },
    {
      "shot": "../../design/claude-design/screenshots/57-ersatzeffekt-dialog.png"
    },
    {
      "js": "(()=>{const b=[...document.querySelectorAll('button')].find(e=>e.textContent==='Keinen anwenden');if(!b)return 'kein Knopf';b.click();return 'Keinen anwenden'})()"
    },
    {
      "wait": 2500
    },
    {
      "js": "(()=>{const g=window.__ml.game.getState();return 'Prompt jetzt: '+(g.prompt?g.prompt.kind+' '+(g.prompt.messageText||''):'-')+' | Hand: '+g.state.hand.map(c=>c.name).join(', ')})()"
    },
    {
      "js": "new Promise(r=>{const t=setInterval(()=>{const g=window.__ml.game.getState();const p=g.prompt;if(p&&p.choice&&p.choice.groups&&g.answeredPromptId!==p.id){clearInterval(t);r('Dialog 2')}},200)})"
    },
    {
      "wait": 1200
    },
    {
      "js": "(()=>{const c=document.querySelector('input[type=checkbox]');if(c&&!c.checked)c.click();const b=[...document.querySelectorAll('button')].find(e=>e.textContent==='Keinen anwenden');if(!b)return 'kein Knopf';b.click();return 'merken + Keinen anwenden'})()"
    },
    {
      "js": "new Promise(r=>{const t=setInterval(()=>{const s=window.__ml.game.getState().state;if(s&&s.replDeclines&&s.replDeclines.length){clearInterval(t);r('gemerkt: '+s.replDeclines.join(', '))}},200)})"
    },
    {
      "wait": 1500
    },
    {
      "js": "new Promise(r=>{const t0=Date.now();const done=i=>i.complete&&i.naturalWidth>0&&!i.classList.contains('opacity-0');const t=setInterval(()=>{const imgs=[...document.images].filter(i=>i.getBoundingClientRect().width>0);if(imgs.every(done)||Date.now()-t0>25000){clearInterval(t);setTimeout(()=>r('Bilder '+imgs.filter(done).length+'/'+imgs.length),400)}},250)})"
    },
    {
      "shot": "../../design/claude-design/screenshots/58-ersatzeffekt-gemerkt.png"
    },
    {
      "wait": 300
    },
    {
      "shot": "../../design/claude-design/screenshots/58-ersatzeffekt-gemerkt.png"
    },
    {
      "js": "clearInterval(window.__pilot);window.__pilot=null;window.__ml.game.getState().leave();'aufgegeben'"
    },
    {
      "wait": 2500
    }
  ]
}
