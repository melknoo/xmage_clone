    },
    {
      "js": "new Promise(r=>{const t=setInterval(()=>{const g=window.__ml.game.getState();const p=g.prompt;const s=g.state;if(p&&p.kind==='SELECT'&&p.mode==='attackers'&&g.answeredPromptId!==p.id&&s&&s.combat.every(c=>c.attackers.length===0)){clearInterval(t);r('zurueck beim Angriffs-Prompt, Angreifer: 0')}},200);setTimeout(()=>{clearInterval(t);const s=window.__ml.game.getState().state;r('Timeout, Angreifer: '+s.combat.reduce((n,c)=>n+c.attackers.length,0))},20000)})"
