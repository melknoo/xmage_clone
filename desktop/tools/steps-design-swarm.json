    },
    {
      "js": "new Promise(r=>{const t=setInterval(()=>{const g=window.__ml.game.getState();const p=g.prompt;const s=g.state;const n=s?s.combat.reduce((k,c)=>k+c.attackers.length,0):0;if(p&&p.kind==='SELECT'&&p.mode==='attackers'&&g.answeredPromptId!==p.id&&n===0){clearInterval(t);r('zurueckgesetzt, Angreifer: 0')}},200);setTimeout(()=>{clearInterval(t);const s=window.__ml.game.getState().state;r('Timeout Reset, Angreifer: '+s.combat.reduce((k,c)=>k+c.attackers.length,0))},30000)})"
