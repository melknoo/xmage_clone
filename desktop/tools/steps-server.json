{
 "url": "{{UI}}/",
 "width": 1680,
 "height": 1000,
 "exact": true,
 "show": true,
 "timeout": 240000,
 "vars": {
  "UI": "http://localhost:5174"
 },
 "steps": [
  {
   "waitFor": "#root form",
   "timeout": 60000
  },
  {
   "wait": 800
  },
  {
   "jsFile": "wait-images.js"
  },
  {
   "shot": "{{OUT}}/../szenario/server-login.png"
  },
  {
   "click": "[data-testid=login-tab-mail]"
  },
  {
   "wait": 500
  },
  {
   "jsFile": "wait-images.js"
  },
  {
   "shot": "{{OUT}}/../szenario/server-login-email.png"
  },
  {
   "goto": "{{UI}}/#invite={{OWNER_CODE}}"
  },
  {
   "waitFor": "#root nav",
   "timeout": 60000
  },
  {
   "wait": 1500
  },
  {
   "jsFile": "wait-images.js"
  },
  {
   "shot": "{{OUT}}/../szenario/server-home.png"
  },
  {
   "js": "window.__ml.nav.getState().go('account');'account'"
  },
  {
   "wait": 1200
  },
  {
   "jsFile": "wait-images.js"
  },
  {
   "shot": "{{OUT}}/../szenario/server-account.png"
  },
  {
   "js": "window.__ml.nav.getState().go('admin');'admin'"
  },
  {
   "wait": 1500
  },
  {
   "jsFile": "wait-images.js"
  },
  {
   "shot": "{{OUT}}/../szenario/server-admin.png"
  },
  {
   "js": "window.__ml.api.start({deck:{type:'random'},bots:[{type:'random'},{type:'random'},{type:'random'}],tempo:'BLITZ'})",
   "expect": "^[0-9a-f]{8}-",
   "name": "Spiel starten"
  },
  {
   "wait": 6000
  },
  {
   "jsFile": "autoplay.js",
   "expect": "started|already"
  },
  {
   "wait": 30000
  },
  {
   "js": "(() => { const g = window.__ml.game.getState(); const s = g.state; return s ? ('Zug ' + s.turn + ' ' + s.step + ' conn=' + g.conn) : 'kein State' })()"
  },
  {
   "jsFile": "wait-images.js"
  },
  {
   "shot": "{{OUT}}/../szenario/server-game.png"
  },
  {
   "js": "['__pilot','__auto','__swarm','__dredge'].forEach(k=>{clearInterval(window[k]);window[k]=null});window.__hold={};'Piloten aus'",
   "name": "Piloten aus"
  },
  {
   "js": "(()=>{const g=window.__ml.game.getState();if(g.gameId)g.leave();return 'aufgegeben'})()"
  }
 ]
}
