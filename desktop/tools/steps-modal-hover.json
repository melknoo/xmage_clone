{
 "url": "{{UI}}/?port={{PORT}}",
 "width": 1680,
 "height": 1000,
 "exact": true,
 "show": true,
 "timeout": 180000,
 "steps": [
  {
   "waitFor": "#root nav, [data-testid=game-header], [data-testid=boot-screen][data-phase=down]",
   "timeout": 60000
  },
  {
   "js": "window.__ml.api.start({deck:{type:'random'},bots:[{type:'random'},{type:'random'},{type:'random'}],tempo:'BLITZ'})",
   "expect": "^[0-9a-f]{8}-",
   "name": "Spiel starten"
  },
  {
   "js": "new Promise(r=>{const t=setInterval(()=>{const g=window.__ml.game.getState();const p=g.prompt;const s=g.state;if(p&&s&&g.answeredPromptId!==p.id&&(p.kind==='ASK'&&p.mulligan)){clearInterval(t);r('Mulligan-Dialog')}},200);setTimeout(()=>{clearInterval(t);r(\"Timeout Prompt\")},60000)})"
  },
  {
   "waitFor": "[data-testid=game-modal] [data-obj]",
   "timeout": 10000
  },
  {
   "wait": 1000
  },
  {
   "hover": "[data-testid=game-modal] [data-obj]"
  },
  {
   "wait": 800
  },
  {
   "js": "(()=>{const h=window.__ml.game.getState().hover;return h?'Vorschau: '+h.name:'kein Hover'})()"
  },
  {
   "jsFile": "wait-images.js"
  },
  {
   "shot": "{{OUT}}/../szenario/modal-hover-1.png"
  }
 ]
}
