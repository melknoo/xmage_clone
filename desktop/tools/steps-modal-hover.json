{
  "url": "http://localhost:5173/?port=7317",
  "width": 1700,
  "height": 1000,
  "timeout": 180000,
  "steps": [
    { "waitFor": "#root div", "timeout": 60000 },
    { "js": "fetch('http://127.0.0.1:7317/api/games',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({deck:{type:'random'},bots:[{type:'random'},{type:'random'},{type:'random'}],tempo:'BLITZ'})}).then(r=>r.json()).then(j=>{window.__ml.game.getState().connect(j.gameId);window.__ml.nav.getState().go('game');return j.gameId})" },
    { "js": "new Promise(r=>{const t=setInterval(()=>{const g=window.__ml.game.getState();const p=g.prompt;if(p&&p.kind==='ASK'&&p.mulligan&&g.answeredPromptId!==p.id){clearInterval(t);r('Mulligan-Dialog')}},200);setTimeout(()=>{clearInterval(t);r('kein Mulligan-Prompt')},60000)})" },
    { "wait": 1500 },
    { "js": "(()=>{const el=document.querySelector('.fixed.inset-0 [data-obj]');if(!el)return 'keine Karte im Dialog';el.dispatchEvent(new MouseEvent('mouseenter',{bubbles:true}));el.dispatchEvent(new MouseEvent('mouseover',{bubbles:true}));return 'hover '+el.getAttribute('data-obj')})()" },
    { "wait": 800 },
    { "js": "(()=>{const h=window.__ml.game.getState().hover;return 'Vorschau: '+(h?h.name:'-')})()" },
    { "shot": "../../engine/run/modal-hover-1.png" },
    { "wait": 300 },
    { "shot": "../../engine/run/modal-hover-1.png" }
  ]
}
