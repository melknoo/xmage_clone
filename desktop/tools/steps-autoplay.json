{
 "url": "{{UI}}/?port={{PORT}}",
 "width": 1680,
 "height": 1000,
 "exact": true,
 "show": true,
 "timeout": 200000,
 "steps": [
  {
   "waitFor": "#root nav, [data-testid=game-header], [data-testid=boot-screen][data-phase=down]",
   "timeout": 60000
  },
  {
   "js": "window.__ml.api.start({deck:{type:'random'},bots:[{type:'random'},{type:'random'},{type:'random'}],tempo:'BLITZ'})",
   "expect": "^[0-9a-f]{8}-",
   "name": "Spiel starten"
  },
  {
   "wait": 6000
  },
  {
   "jsFile": "autoplay.js",
   "expect": "started|already"
  },
  {
   "wait": 30000
  },
  {
   "js": "(() => { const s = window.__ml.game.getState().state; return s ? ('Zug ' + s.turn + ' ' + s.step) : 'kein State' })()"
  },
  {
   "shot": "{{OUT}}/../szenario/shot-1.png"
  },
  {
   "wait": 30000
  },
  {
   "shot": "{{OUT}}/../szenario/shot-2.png"
  },
  {
   "wait": 30000
  },
  {
   "shot": "{{OUT}}/../szenario/shot-3.png"
  }
 ]
}
