{
 "url": "{{UI}}/#invite={{OWNER_CODE}}",
 "width": 1680,
 "height": 1000,
 "exact": true,
 "show": true,
 "timeout": 120000,
 "vars": {
  "UI": "http://localhost:5174"
 },
 "steps": [
  {
   "waitFor": "#root nav",
   "timeout": 60000
  },
  {
   "wait": 5000
  },
  {
   "jsFile": "wait-images.js"
  },
  {
   "shot": "{{OUT}}/../szenario/social-home.png"
  },
  {
   "click": "[data-testid=chat-member][data-name=Bob]"
  },
  {
   "waitFor": "[data-testid=member-menu]",
   "timeout": 5000
  },
  {
   "jsFile": "wait-images.js"
  },
  {
   "shot": "{{OUT}}/../szenario/social-pick.png"
  },
  {
   "key": "Escape"
  },
  {
   "click": "[data-testid=invite-accept]",
   "optional": true
  },
  {
   "wait": 2500
  },
  {
   "jsFile": "wait-images.js"
  },
  {
   "shot": "{{OUT}}/../szenario/social-table.png"
  },
  {
   "js": "window.__ml.nav.getState().go('home');'home'"
  },
  {
   "wait": 1500
  },
  {
   "click": "[data-testid=chat-leave]"
  },
  {
   "waitFor": "[data-testid=chat-hidden]",
   "timeout": 8000
  },
  {
   "wait": 1000
  },
  {
   "jsFile": "wait-images.js"
  },
  {
   "shot": "{{OUT}}/../szenario/social-left.png"
  },
  {
   "click": "[data-testid=chat-join]"
  },
  {
   "waitFor": "[data-testid=lobby-chat]",
   "timeout": 8000
  }
 ]
}
