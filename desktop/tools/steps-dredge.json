{
 "url": "{{UI}}/?port={{PORT}}",
 "width": 1680,
 "height": 1000,
 "exact": true,
 "show": true,
 "timeout": 420000,
 "steps": [
  {
   "waitFor": "#root nav, [data-testid=game-header], [data-testid=boot-screen][data-phase=down]",
   "timeout": 60000
  },
  {
   "js": "window.__ml.api.start({deck:{type:'random'},bots:[{type:'random'},{type:'random'},{type:'random'}],tempo:'BLITZ',scenario:'dredge'})",
   "expect": "^[0-9a-f]{8}-",
   "name": "Spiel starten (dredge)"
  },
  {
   "wait": 3000
  },
  {
   "jsFile": "dredge-pilot.js",
   "expect": "started|already"
  },
  {
   "js": "new Promise(r=>{const t=setInterval(()=>{const g=window.__ml.game.getState();const p=g.prompt;const s=g.state;if(p&&s&&g.answeredPromptId!==p.id&&(p.choice&&p.choice.groups)){clearInterval(t);r('Dialog: '+p.choice.groups.map(x=>x.label+'x'+x.sources.length).join(', '))}},200);setTimeout(()=>{clearInterval(t);r(\"Timeout Prompt\")},180000)})"
  },
  {
   "waitFor": "[data-testid=game-modal]",
   "timeout": 8000
  },
  {
   "hover": "[data-testid=game-modal] button[title^=\"Effekt von Necroplasm\"]"
  },
  {
   "wait": 600
  },
  {
   "jsFile": "wait-images.js"
  },
  {
   "shot": "{{OUT}}/../szenario/dredge-1-dialog.png"
  },
  {
   "click": "[data-testid=repl-decline-all]"
  },
  {
   "click": "[data-testid=repl-confirm]"
  },
  {
   "wait": 2500
  },
  {
   "js": "(()=>{const g=window.__ml.game.getState();return 'Prompt jetzt: '+(g.prompt?g.prompt.kind+' '+(g.prompt.messageText||''):'-')+' | Hand: '+g.state.hand.map(c=>c.name).join(', ')})()"
  },
  {
   "js": "new Promise(r=>{const t=setInterval(()=>{const g=window.__ml.game.getState();const p=g.prompt;const s=g.state;if(p&&s&&g.answeredPromptId!==p.id&&(p.choice&&p.choice.groups)){clearInterval(t);r('Dialog 2')}},200);setTimeout(()=>{clearInterval(t);r(\"Timeout Prompt\")},180000)})"
  },
  {
   "waitFor": "[data-testid=game-modal]",
   "timeout": 8000
  },
  {
   "wait": 800
  },
  {
   "click": "[data-testid=repl-decline-all]"
  },
  {
   "js": "(()=>{const c=document.querySelector('[data-testid=repl-remember]');if(!c)return 'kein Merken';if(!c.checked)c.click();return 'merken: '+c.checked})()"
  },
  {
   "click": "[data-testid=repl-confirm]"
  },
  {
   "js": "new Promise(r=>{const t=setInterval(()=>{const g=window.__ml.game.getState();const s=g.state;if(s&&(s.replDeclines&&s.replDeclines.length)){clearInterval(t);r('gemerkt: '+s.replDeclines.join(', '))}},150);setTimeout(()=>{clearInterval(t);r(\"Timeout Zustand\")},20000)})"
  },
  {
   "wait": 1500
  },
  {
   "jsFile": "wait-images.js"
  },
  {
   "shot": "{{OUT}}/../szenario/dredge-2-gemerkt.png"
  }
 ]
}
