  },
  {
   "js": "new Promise(r=>{const t=setInterval(()=>{const g=window.__ml.game.getState();const p=g.prompt;const s=g.state;if(p&&s&&g.answeredPromptId!==p.id&&(p.kind==='SELECT'&&p.mode==='priority'&&s.stack.length>0&&s.stack[0].name==='Blaze')){clearInterval(t);r('Blaze auf dem Stapel')}},150);setTimeout(()=>{clearInterval(t);r(\"Timeout Blaze auf dem Stapel\")},30000)})",
   "name": "Blaze auf dem Stapel"
  },
