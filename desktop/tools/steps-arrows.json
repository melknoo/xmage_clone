{
 "url": "{{UI}}/?port={{PORT}}",
 "width": 1680,
 "height": 1000,
 "exact": true,
 "show": true,
 "timeout": 1500000,
 "steps": [
  {
   "waitFor": "#root nav, [data-testid=game-header], [data-testid=boot-screen][data-phase=down]",
   "timeout": 90000
  },
  {
   "wait": 2500
  },
  {
   "js": "(()=>{const g=window.__ml.game.getState();if(g.gameId){g.leave();g.reset&&g.reset();window.__ml.nav.getState().go('home');return 'altes Spiel beendet'}return 'frisch'})()"
  },
  {
   "localStorage": {
    "magelite.autoMana": "0",
    "magelite.arrows": "1",
    "magelite.fx": "1"
   },
   "reload": true
  },
  {
   "waitFor": "#root nav",
   "timeout": 60000
  },
  {
   "wait": 1500
  },
  {
   "js": "window.__ml.api.start({deck:{type:'random'},bots:[{type:'random'},{type:'random'},{type:'random'}],tempo:'BLITZ',scenario:'convoke'})",
   "expect": "^[0-9a-f]{8}-",
   "name": "Spiel starten (convoke)"
  },
  {
   "js": "window.__hold={convoke:true,firstMain:true,blazeTarget:true,afterGuardian:true,mana:true};'hold'"
  },
  {
   "jsFile": "scenario-pilot.js",
   "expect": "started|already"
  },
  {
   "js": "new Promise(r=>{const t=setInterval(()=>{const g=window.__ml.game.getState();const p=g.prompt;const s=g.state;if(p&&s&&g.answeredPromptId!==p.id&&(p.kind==='SELECT'&&p.mode==='priority'&&s.step==='PRECOMBAT_MAIN')){clearInterval(t);r('Main 1')}},150);setTimeout(()=>{clearInterval(t);r(\"Timeout Main 1\")},120000)})",
   "name": "Main 1"
  },
  {
   "js": "(()=>{const a=document.querySelector('[data-testid=toggle-auto-mana]'),b=document.querySelector('[data-testid=toggle-auto-pass]');const bar=document.querySelector('[data-testid=prompt-bar]');return a&&b&&bar.contains(a)&&bar.contains(b)&&!document.querySelector('[data-testid=game-header] [aria-pressed]')?'Schalter in der Leiste, Auto-Mana '+a.getAttribute('aria-pressed'):'kein Schalter in der Leiste'})()",
   "expect": "^Schalter in der Leiste",
   "name": "Schalter unten"
  },
  {
   "wait": 400
  },
  {
   "jsFile": "wait-images.js"
  },
