   "js": "new Promise(r=>{const t=setInterval(()=>{const g=window.__ml.game.getState();const p=g.prompt;const s=g.state;if(p&&s&&g.answeredPromptId!==p.id&&(p.kind==='PLAY_MANA'&&!!p.specialBtn)){clearInterval(t);r('Mana Guardian (Einberufen)')}},150);setTimeout(()=>{clearInterval(t);r(\"Timeout Mana Guardian (Einberufen)\")},60000)})",
