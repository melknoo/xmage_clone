{
 "url": "{{UI}}/?port={{PORT}}",
 "width": 1680,
 "height": 1000,
 "exact": true,
 "show": true,
 "timeout": 300000,
 "steps": [
  {
   "waitFor": "#root nav, [data-testid=game-header], [data-testid=boot-screen][data-phase=down]",
   "timeout": 60000
  },
  {
   "js": "window.__ml.api.start({deck:{type:'random'},bots:[{type:'random'},{type:'random'},{type:'random'}],tempo:'BLITZ',scenario:'swarm'})",
   "expect": "^[0-9a-f]{8}-",
   "name": "Spiel starten (swarm)"
  },
  {
   "wait": 4000
  },
  {
   "jsFile": "swarm-pilot.js",
   "expect": "started|already"
  },
  {
   "js": "new Promise(r=>{const t=setInterval(()=>{const g=window.__ml.game.getState();const s=g.state;if(s&&(s.stack.length>=5)){clearInterval(t);r('Stapel '+s.stack.length)}},150);setTimeout(()=>{clearInterval(t);r(\"Timeout Zustand\")},120000)})"
  },
  {
   "wait": 1500
  },
  {
   "jsFile": "wait-images.js"
  },
  {
   "shot": "{{OUT}}/../szenario/swarm-1-stapel.png"
  },
  {
   "js": "new Promise(r=>{const t=setInterval(()=>{const g=window.__ml.game.getState();const p=g.prompt;const s=g.state;if(p&&s&&g.answeredPromptId!==p.id&&(p.kind==='SELECT'&&p.mode==='attackers')){clearInterval(t);r('Angriff, moeglich: '+p.possibleAttackers.length)}},200);setTimeout(()=>{clearInterval(t);r(\"Timeout Prompt\")},120000)})"
  },
  {
   "wait": 1500
  },
  {
   "jsFile": "wait-images.js"
  },
  {
   "shot": "{{OUT}}/../szenario/swarm-2-angriff.png"
  },
  {
   "js": "(()=>{const g=window.__ml.game.getState();const pa=new Set(g.prompt.possibleAttackers);document.querySelectorAll('[data-shot-target]').forEach(e=>e.removeAttribute('data-shot-target'));const el=[...document.querySelectorAll('[data-objs]')].find(e=>e.getAttribute('data-objs').split(' ').some(id=>pa.has(id)));if(!el)return 'kein Stapel gefunden';el.querySelector('[data-obj]').setAttribute('data-shot-target','1');return 'Stapel markiert'})()"
  },
  {
   "click": "[data-shot-target]",
   "shift": true
  },
  {
   "wait": 600
  },
  {
   "js": "'markiert: '+window.__ml.game.getState().marked.size"
  },
  {
   "wait": 1000
  },
  {
   "jsFile": "wait-images.js"
  },
  {
   "shot": "{{OUT}}/../szenario/swarm-3-markiert.png"
  },
  {
   "js": "(()=>{const s=window.__ml.game.getState().state;const opp=s.players.find(p=>!p.me&&!p.lost);document.querySelectorAll('[data-shot-target]').forEach(e=>e.removeAttribute('data-shot-target'));const el=document.querySelector('[data-testid=opp-pod][data-player=\"'+opp.id+'\"]')||document.querySelector('[data-player=\"'+opp.id+'\"]');if(!el)return 'kein Pod';el.setAttribute('data-shot-target','1');return 'Ziel '+opp.name})()"
  },
  {
   "click": "[data-shot-target]"
  },
  {
   "js": "new Promise(r=>{const t=setInterval(()=>{const g=window.__ml.game.getState();const p=g.prompt;const s=g.state;if(p&&s&&g.answeredPromptId!==p.id&&(p.kind==='SELECT'&&p.mode==='attackers'&&s.combat.some(c=>c.attackers.length))){clearInterval(t);r('Angreifer: '+s.combat.reduce((n,c)=>n+c.attackers.length,0))}},200);setTimeout(()=>{clearInterval(t);r(\"Timeout Prompt\")},30000)})"
  },
  {
   "wait": 1500
  },
  {
   "jsFile": "wait-images.js"
  },
  {
   "shot": "{{OUT}}/../szenario/swarm-4-etiketten.png"
  },
  {
   "js": "(()=>{window.__ml.game.getState().answer({bool:true});return 'bestaetigt'})()"
  },
  {
   "wait": 8000
  },
  {
   "jsFile": "wait-images.js"
  },
  {
   "shot": "{{OUT}}/../szenario/swarm-5-verlauf.png"
  }
 ]
}
