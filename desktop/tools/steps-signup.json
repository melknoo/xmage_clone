{
 "url": "{{UI}}/",
 "width": 1680,
 "height": 1000,
 "exact": true,
 "show": true,
 "timeout": 240000,
 "vars": {
  "UI": "http://localhost:5176"
 },
 "steps": [
  { "js": "fetch('/api/auth/logout',{method:'POST',headers:{'Content-Type':'application/json'},body:'{}'}).then(()=>location.reload());'logout'" },
  { "wait": 1500 },
  { "waitFor": "#root form", "timeout": 60000 },
  { "click": "[data-testid=login-tab-code]" },
  { "wait": 600 },
  { "jsFile": "wait-images.js" },
  { "shot": "../../engine/run/signup/login-code.png" },
  { "click": "[data-testid=login-tab-signup]" },
  { "wait": 500 },
  { "shot": "../../engine/run/signup/signup-form.png" },
  { "type": { "target": "[data-testid=signup-name]", "text": "Carla", "clear": true } },
  { "type": { "target": "[data-testid=signup-email]", "text": "carla@example.org", "clear": true } },
  { "type": { "target": "[data-testid=signup-password]", "text": "geheim123", "clear": true } },
  { "wait": 300 },
  { "shot": "../../engine/run/signup/signup-filled.png" },
  { "click": "[data-testid=signup-submit]" },
  { "waitFor": "[data-testid=signup-sent]", "timeout": 15000 },
  { "wait": 400 },
  { "shot": "../../engine/run/signup/signup-sent.png" },
  { "click": "[data-testid=signup-back]" },
  { "wait": 400 },
  { "click": "[data-testid=login-tab-mail]" },
  { "wait": 400 },
  { "type": { "target": "input[type=email]", "text": "bob@example.org", "clear": true } },
  { "type": { "target": "input[autocomplete=current-password]", "text": "geheim123", "clear": true } },
  { "click": "[data-testid=login-submit]" },
  { "waitFor": "[data-testid=login-unverified]", "timeout": 15000 },
  { "wait": 400 },
  { "shot": "../../engine/run/signup/login-unverified.png" },
  { "click": "[data-testid=login-forgot]" },
  { "wait": 400 },
  { "shot": "../../engine/run/signup/forgot.png" },
  { "js": "window.__ml.auth.getState().setResetToken('demo');'reset'" },
  { "wait": 400 },
  { "shot": "../../engine/run/signup/reset.png" },
  { "js": "window.__ml.auth.getState().setResetToken(null);fetch('/api/auth/login',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({email:'alice@example.org',password:'geheim123'})}).then(()=>location.reload());'alice'" },
  { "wait": 1500 },
  { "waitFor": "#root nav", "timeout": 60000 },
  { "wait": 1500 },
  { "jsFile": "wait-images.js" },
  { "shot": "../../engine/run/signup/public-home.png" },
  { "js": "window.__ml.nav.getState().go('play');'play'" },
  { "wait": 1200 },
  { "click": "[data-testid=lobby-open-table]" },
  { "waitFor": "[data-testid=create-table-dialog]", "timeout": 10000 },
  { "wait": 500 },
  { "shot": "../../engine/run/signup/public-create-table.png" },
  { "click": "[data-testid=modal-cancel]" },
  { "wait": 400 },
  { "js": "window.__ml.auth.setState({budgetLimited:true,budgetResetsAt:Date.UTC(2026,10,1)});'budget'" },
  { "waitFor": "[data-testid=budget-screen]", "timeout": 10000 },
  { "wait": 500 },
  { "shot": "../../engine/run/signup/budget-screen.png" },
  { "js": "window.__ml.auth.setState({budgetLimited:false});fetch('/api/auth/logout',{method:'POST',headers:{'Content-Type':'application/json'},body:'{}'}).then(()=>{location.href='{{UI}}/#invite={{OWNER_CODE}}';location.reload()});'owner'" },
  { "wait": 2000 },
  { "waitFor": "#root nav", "timeout": 60000 },
  { "js": "window.__ml.nav.getState().go('admin');'admin'" },
  { "wait": 2000 },
  { "shot": "../../engine/run/signup/admin-users.png" },
  { "click": { "text": "Alice" } },
  { "wait": 1500 },
  { "shot": "../../engine/run/signup/admin-user-detail.png" },
  { "click": { "text": "Server", "pointer": true } },
  { "wait": 1500 },
  { "shot": "../../engine/run/signup/admin-server.png" }
 ]
}
