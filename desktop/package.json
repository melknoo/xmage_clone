{
  "name": "magelite",
  "productName": "MageLite",
  "version": "0.2.0",
  "description": "Commander-Goldfish gegen 3 Bots (Forge-Engine)",
  "license": "GPL-3.0-or-later",
  "author": "MageLite",
  "main": "src/main.cjs",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dev": "cross-env MAGELITE_UI_DEV=1 electron .",
    "shot": "electron tools/shot.cjs",
    "dist": "electron-builder --win nsis"
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "dev.magelite.app",
    "productName": "MageLite",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../engine/build/install/magelite-engine/lib",
        "to": "engine/lib"
      },
      {
        "from": "../ui/dist",
        "to": "ui"
      },
      {
        "from": "../vendor/forge",
        "to": "forge",
        "filter": [
          "res/**",
          "forge.profile.properties",
          "manifest.json",
          "LICENSE-Forge.txt"
        ]
      },
      {
        "from": "out/jre",
        "to": "jre"
      },
      {
        "from": "../LICENSE",
        "to": "LICENSE.txt"
      },
      {
        "from": "../LICENSES",
        "to": "licenses"
      },
      {
        "from": "out/SOURCE.txt",
        "to": "SOURCE.txt"
      }
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "MageLite",
      "artifactName": "MageLite-Setup-${version}.exe"
    }
  }
}
